# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Search API Configuration (Optional: DuckDuckGo fallback will be used if omitted)
TAVILY_API_KEY=your_tavily_api_key_here

# Firecrawl API Configuration (Optional: BeautifulSoup fallback used if omitted)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./research.db

# Research Pipeline Limits
MAX_SEARCHES_PER_RUN=10
MAX_PAGES_PROCESSED=15
MAX_CONTENT_LENGTH_PER_PAGE=12000
HTTP_TIMEOUT_SECONDS=15
